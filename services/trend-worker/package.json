{
  "name": "@hypit/trend-worker",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "discover": "node --import tsx src/cli/main.ts discover",
    "rank": "node --import tsx src/cli/main.ts rank",
    "download": "node --import tsx src/cli/main.ts download",
    "upload": "node --import tsx src/cli/main.ts upload",
    "run": "node --import tsx src/cli/main.ts run",
    "prune": "node --import tsx src/cli/main.ts prune",
    "stats": "node --import tsx src/cli/main.ts stats",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@hypit/yt-dlp": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
