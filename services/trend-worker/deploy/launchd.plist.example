<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hypit.trend-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pnpm</string>
    <string>trend:run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/amao/Projects/hypit</string>
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>StandardOutPath</key>
  <string>/Users/amao/Projects/hypit/data/trend-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/amao/Projects/hypit/data/trend-worker.error.log</string>
</dict>
</plist>
